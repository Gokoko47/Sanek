# Server environment only. Never commit actual values.
TELEGRAM_BOT_TOKEN=replace-with-token-from-BotFather
# Start with 0, send /id to your bot, then set your numeric ID here and restart.
TELEGRAM_OWNER_ID=0
OPENAI_API_KEY=replace-with-your-provider-key
OPENAI_MODEL=gpt-4.1-mini
REPLY_STYLE=Дружелюбно, кратко, с лёгким юмором.
STATE_PATH=data/business.sqlite3
MAX_REPLIES_PER_HOUR=60
CHAT_COOLDOWN_SECONDS=5
MANUAL_PAUSE_SECONDS=1800
