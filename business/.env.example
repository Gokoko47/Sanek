# Server environment only. Never commit actual values.
TELEGRAM_BOT_TOKEN=replace-with-token-from-BotFather
# Start with 0, send /id to your bot, then set your numeric ID here and restart.
TELEGRAM_OWNER_ID=0
OPENAI_API_KEY=replace-with-your-provider-key
OPENAI_MODEL=gpt-4.1-mini
REPLY_STYLE=Коротко, разговорно, на ты, с маленькой буквы, без канцелярита и лишних эмодзи.
STATE_PATH=data/business.sqlite3
MAX_REPLIES_PER_HOUR=60
CHAT_COOLDOWN_SECONDS=5
MANUAL_PAUSE_SECONDS=1800

# Quiet-window batching. Runtime /delay overrides DEBOUNCE_SECONDS.
DEBOUNCE_SECONDS=6
MAX_BATCH_WAIT_SECONDS=20
MAX_MESSAGE_AGE_SECONDS=180
MAX_AI_REQUESTS_PER_HOUR=90
# Bounded local context; disable/clear with /memory.
CONTEXT_TTL_SECONDS=86400
CONTEXT_MAX_MESSAGES=12
CONTEXT_MAX_CHARS=6000
# Explicit opt-in; /voice setting persists and overrides this default.
VOICE_ENABLED=0
VOICE_MAX_BYTES=10485760
VOICE_MAX_SECONDS=300
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
